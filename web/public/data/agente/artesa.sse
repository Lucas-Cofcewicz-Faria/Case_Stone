ibuto": "duracao_faixa=ate_15s", "lift": 0.55, "posts_top": 19, "z": -2.48, "tipo": "antipadrao"}, {"atributo": "duracao_faixa=15_30s", "lift": 0.68, "posts_top": 41, "z": -2.42, "tipo": "antipadrao"}, {"atributo": "tom=humoristico", "lift": 0.45, "posts_top": 9, "z": -2.23, "tipo": "antipadrao"}, {"atributo": "formato_video=humor_esquete", "lift": 0.42, "posts_top": 7, "z": -2.14, "tipo": "antipadrao"}, {"atributo": "clareza_mensagem_0a10=media", "lift": 0.21, "posts_top": 1, "z": -1.4, "tipo": "neutro"}, {"atributo": "pilar_impulso=historias_reais", "lift": 0.78, "posts_top": 26, "z": -1.16, "tipo": "neutro"}]}}}}

