4.99, "similaridade": 0.76}, {"post_id": "P03sQMLwyOo", "titulo": "O que é estratégica de negócios", "url": "https://www.youtube.com/shorts/P03sQMLwyOo", "perfil": "Blog Abri Minha Empresa", "conversa": 6.31, "similaridade": 0.72}, {"post_id": "GG4yYezMW1Q", "titulo": "4 CURSOS GRÁTIS pra começar bem o seu NEGÓCIO", "url": "https://www.youtube.com/shorts/GG4yYezMW1Q", "perfil": "Sebrae", "conversa": 68.22, "similaridade": 0.67}], "aviso": "A nota mede semelhança com posts que geraram conversa na base; não prevê resultado.", "rubrica_do_rascunho": {"texto_na_tela": "talking_head", "formato_video": "tutorial", "hook_primeiros_3s": "talking_head", "tipo_hook": "pergunta", "forca_hook_0a10": 8, "tema_principal": "gestao", "pilar_impulso": "gestao_e_vendas", "tem_rosto": true, "criador_e_empreendedor_real": true, "prova_social": false, "tom": "informal", "usa_linguagem_regional": false, "clareza_mensagem_0a10": 9, "tem_cta": true, "tipo_cta": "comentar", "oferta_ou_beneficio_explicito": true, "legenda_tamanho": "longa", "tipo_post": "short", "duracao_faixa": "30_60s"}, "problemas": ["o post mostra o Impulso como app (tela, botão): o Impulso é um programa de conteúdo"], "graves": ["o post mostra o Impulso como app (tela, botão): o Impulso é um programa de conteúdo"], "tentativa": 2}, "historico": [{"tentativa": 1, "nota": 50, "titulo": "Quer atender prédios da região? Isso aqui vai te salvar.", "problemas": 1}, {"tentativa": 2, "nota": 32, "titulo": "Prédios não querem você? Tá na hora de mudar a estratégia.", "problemas": 1}], "melhor": {"criativo": {"titulo": "Quer atender prédios da região? Isso aqui vai te salvar.", "gancho": "Seu negócio tá crescendo… mas os prédios ainda não querem abrir a porta pra você.", "tipo_hook": "promessa", "formato": "bastidores", "duracao_s": 46, "roteiro": ["Dono de lavanderia, camisa suja, olhando para câmera com cara de cansado. Fala: Eu já tentei tudo: ligar, bater na porta, até mandar um e-mail. Mas os síndicos só me dizem: 'Não temos espaço'.", "Câmera se aproxima do celular dele, mostrando uma lista de prédios em um app (não é app da Stone). Fala: Foi quando eu vi que o problema não era a gente… era a forma como eu estava entrando.", "Ele pega um papel e escreve algo com caneta. Fala: Aqui vai o segredo: você precisa entrar com um pacote. Não só serviço, mas com preço fixo, entrega no prédio, até um cartaz pra mostrar que tá tudo certo.", "Mostra uma foto de um cartaz colorido com os dados do negócio (não é da Stone). Fala: E se você fizer isso em 3 prédios… aí começa a virar rotina. Os síndicos vão entender que você não é só mais um lavador… é um parceiro.", "Ele olha para câmera e sorri. Fala: Agora, o que você vai fazer primeiro? Vai tentar entrar em 1 prédio ou já pensou em 5?"], "texto_na_tela": "Como entrar nos prédios da região", "legenda": "Seu negócio tá crescendo… mas os prédios ainda não querem abrir a porta pra você. A gente mostra como entrar sem dar treta. 👇", "cta": "Qual prédio você vai tentar primeiro? Comenta com o nome dele! 👇", "tipo_cta": "comentar", "justificativa": "O CTA pede uma ação concreta e fácil de comentar, alinhado ao padrão de engajamento qualificado do segmento.", "duracao_declarada_s": 60}, "avaliacao": {"nota": 50, "pontos": 0.2, "padroes_cumpridos": [], "antipadroes": [], "sugestoes": [{"campo": "duracao_faixa", "de": "30_60s", "para": "60_180s", "ganho": 0.47, "exemplos": [{"titulo": "RECEITA NÃO É EMPREENDER", "url": "https://www.youtube.com/shorts/6TMsMRsfzTE"}, {"titulo": "PAGUE O PREÇO DA CONQUISTA", "url": "https://www.youtube.com/shorts/7nS7JzYhvps"}]}, {"campo": "tema_principal", "de": "vendas", "para": "burocracia_mei", "ganho": 0.45, "exemplos": [{"titulo": "Quem Conseguiu se Inscrever no DET à tempo?", "url": "https://www.youtube.com/shorts/dzA8ezGR3Xg"}, {"titulo": "Não Vão mais Monitorar o PIX", "url": "https://www.youtube.com/shorts/5lcu0pQkxpI"}]}, {"campo": "usa_linguagem_regional", "de": false, "para": true, "ganho": 0.38, "exemplos": [{